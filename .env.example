# --- Core: API Authentication ---
# Set to true to require Bearer token on all endpoints (except /health, /docs)
SEARCHPROXY_REQUIRE_AUTH=false
SEARCHPROXY_API_KEY=change-me-in-production

# --- Search Providers (Tier 1: Free Quotas) ---
# Active keys are rotated round-robin; on 429 rate limit, fails over immediately
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
SEARCH_COOLDOWN_SECONDS=900

# --- Search: Safety Net / Fallback (Tier 2: SearXNG) ---
SEARXNG_URL=http://searxng:8080/search

# --- Synthesis / AI Inference: OpenAI-Compatible Chat Gateway ---
# Works with any OpenAI-compatible provider: Groq, Cerebras, Cloudflare Workers AI, OpenRouter, etc.
LLM_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
LLM_CHAT_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# --- Retrieve: Reranker (Local ONNX primary, CF fallback) ---
RERANK_LOCAL=true
LOCAL_RERANK_MODEL=BAAI/bge-reranker-base
FASTEMBED_CACHE_PATH=/data/models

# Secondary fallback if local ONNX is disabled or fails:
CF_RERANK_URL=https://cf-inference.binuengoor.workers.dev/v1/rerank
CF_RERANK_API_KEY=
CF_RERANK_MODEL=@cf/baai/bge-reranker-base

# --- Retrieve: tuning ---
RETRIEVE_MAX_CONTENT_PER_SOURCE=6000
RETRIEVE_MAX_TOTAL_CONTENT=12000
RETRIEVE_RERANK_TOP_K=20
RETRIEVE_MIN_CONTENT_LENGTH=300
RETRIEVE_FETCH_TIMEOUT=15
RETRIEVE_PREFETCH_DURING_RERANK=true
RETRIEVE_PREFETCH_MAX=3
SYNTHESIS_MAX_TOKENS=2048
SYNTHESIS_TIMEOUT=60
RERANK_TIMEOUT=10


# --- Fetch: Tier 0 Fast-Fetch (HTTP + Trafilatura) ---
FAST_FETCH_ENABLED=true
FAST_FETCH_TIMEOUT=4.0

# --- Fetch: Crawl4AI (runs inside unified compose) ---
CRAWL4AI_URL=http://crawl4ai:11235
# Optional: LLM config for Crawl4AI structured extraction
CRAWL4AI_LLM_PROVIDER=
CRAWL4AI_LLM_BASE_URL=
CRAWL4AI_LLM_API_KEY=

# --- Fetch: Jina Reader ---
JINA_API_KEY=

# --- Fetch: Byparr / FlareSolverr Cloudflare Solver ---
BYPARR_URL=http://byparr:8191/v1

# --- Fetch: Document Extraction (Apache Tika) ---
TIKA_URL=http://tika:9998/tika

# --- Fetch: Anti-bot specialists ---
SCRAPE_DO_API_KEY=
SCRAPERAPI_API_KEY=

# --- Domain Diversity & Filtering ---
MAX_PER_DOMAIN_SOURCES=2
ENABLE_SSRF_PROTECTION=false

# --- Timeouts ---
FETCH_TIMEOUT=30        # generic fallback; per-tier overrides below
SEARCH_TIMEOUT=15
VANE_TIMEOUT=120
CRAWL4AI_TIMEOUT=15
JINA_TIMEOUT=15
ANTIBOT_TIMEOUT=45
CONNECT_TIMEOUT=5       # shared connect timeout for all downstream HTTP clients

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text  # text or json

# --- Observability ---
OBSERVABILITY_ENABLED=true
OBSERVABILITY_DB_PATH=/data/observability.db
OBSERVABILITY_RETENTION_DAYS=7

# --- Caching ---
CACHE_ENABLED=false          # Set to true to enable SQLite caching for search and fetch results.
CACHE_SEARCH_TTL=300         # TTL for search cache entries in seconds.
CACHE_FETCH_TTL=86400        # TTL for fetch cache entries in seconds.
CACHE_RERANK_TTL=300         # TTL for rerank cache entries in seconds.
CACHE_DB_PATH=/data/cache.db # Path to SQLite cache database (mounted volume).